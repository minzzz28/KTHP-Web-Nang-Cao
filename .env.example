# Copy this file to .env before running Docker or the server.
MYSQL_DATABASE=student_rental
MYSQL_USER=student_rental
MYSQL_PASSWORD=change-this-local-db-password
MYSQL_ROOT_PASSWORD=change-this-local-root-password
MYSQL_PORT=3306
DATABASE_URL="mysql://student_rental:change-this-local-db-password@localhost:3306/student_rental"

PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-development-secret
SESSION_SECRET=replace-with-a-different-long-random-session-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads

VITE_API_URL=/api
VITE_SOCKET_URL=
